# Sao chép thành keystore.properties (đã được .gitignore, không đưa lên Git) rồi điền thông tin khoá phát hành.
# Khoá phải trùng chứng chỉ các bản đã phát hành (SHA-256 853ecf48...06f4), nếu không máy đang cài sẽ không cập nhật đè được.
storeFile=~/my-release-key.jks
keyAlias=key0
storePassword=ĐIỀN_MẬT_KHẨU
# keyPassword=ĐIỀN_NẾU_KHÁC_MẬT_KHẨU_KEYSTORE
